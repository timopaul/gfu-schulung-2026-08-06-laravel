APP_NAME="Laravel Fortgeschrittene Praxis"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Für die Übungen genügt eine In-Memory-SQLite-DB.
# Für ein persistentes Setup: DB_CONNECTION=sqlite und DB_DATABASE=/absoluter/pfad/database.sqlite
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# Multi-Tenancy Demo-Header (siehe EnsureTenantAccess-Middleware)
DEMO_DEFAULT_TENANT=1
