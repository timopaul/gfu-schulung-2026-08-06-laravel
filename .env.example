APP_NAME="Laravel Fortgeschrittene Praxis"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite. Ohne DB_DATABASE nutzt Laravel automatisch database/database.sqlite
# (absolut aufgelöst über database_path()). Genau das brauchen `php artisan serve`
# und die Web-Oberfläche – eine In-Memory-DB würde pro Request wieder geleert.
# Die Tests laufen davon unabhängig In-Memory (siehe phpunit.xml).
DB_CONNECTION=sqlite
# DB_DATABASE=

CACHE_STORE=array
QUEUE_CONNECTION=sync

# file statt array: die Session (Flash-Meldungen, gewählter Mandant) muss den
# Redirect nach einem POST überleben. array-Sessions gelten nur für einen Request.
SESSION_DRIVER=file

# Multi-Tenancy Demo-Header (siehe EnsureTenantAccess-Middleware)
DEMO_DEFAULT_TENANT=1
